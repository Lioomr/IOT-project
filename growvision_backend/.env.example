# Example Backend Environment Variables
# Copy this file to .env and replace placeholder values with your actual local settings.
# NOTE: For this project currently, only MQTT_PASSWORD might be needed if you refactor settings.py
#       SECRET_KEY and DEBUG are currently hardcoded in settings.py for development.


SECRET_KEY=your_unique_django_secret_key_here
DEBUG=True

MQTT_PASSWORD=your_actual_mqtt_password_here

